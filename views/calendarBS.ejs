<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../styles/calendar.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Kombucha Kalendar</title>
    
 
</head>
<%- include("headermenu.ejs") %>
<body>
    
    <div id="calendar"> <div id="calendar-header"> <span id="month-prev" class="change-month">&lt;</span> <h1 id="month"></h1> <span id="month-next" class="change-month">&gt;</span> </div> 
    <div id="days"></div>
    <div id="calendar-body">
    </div>
    </div>


    <div class=" table-responsive">
        <table class="table table-striped">
            <thead class="thead-dark">
              <tr>
                <th scope="col">Batch#</th>
                <th scope="col">Flavor</th>
                <th scope="col">Rating</th>
                <th scope="col">Ingredients</th>
                <th scope="col">Tap Date</th>

              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">101</th>
                <td>Lemon/Blueberry/Ginger</td>
                <td>9/10</td>
                <td>6/1Pint/0.25oz</td>
                <td>8/29/24</td>
              </tr>
              <tr>
                <th scope="row">102</th>
                <td>Blackberry Mint</td>
                <td>8/10 fial</td>
                <td>1.5lb/1.24oz</td>
                <td>9/7/24</td>
              </tr>
              <tr>
                <th scope="row">103</th>
                <td>Lemon Ginger Mint</td>
                <td>TBD</td>
                <td>6ea/8oz/1oz</td>
                <td>9/15/24</td>
              </tr>
            </tbody>
          </table>
    </div>
    <h1>Data:</h1>
    <p id="batch102"></p>
    <p id="batch103"></p>
    <h3 id="output"></h3>
    <%- include("footermain.ejs") %>
    <script src="../js/calendar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
    crossorigin="anonymous"></script>
</body>
</html>
